<Window x:Class="IronworksTranslator.Views.Windows.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="http://schemas.lepo.co/i18n/2022/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:IronworksTranslator.Views.Windows"
        xmlns:Behaviors="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:utils_ui="clr-namespace:IronworksTranslator.Utils.UI"
        xmlns:converters="clr-namespace:IronworksTranslator.Helpers.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:ChatWindow, IsDesignTimeCreatable=True}"
        Name="mainWindow"
        Title="ChatWindow"
        Style="{StaticResource WindowAll}"
        MinWidth="200" MinHeight="{Binding Compose.MinimumWindowHeight}"
        d:Width="400" d:Height="200"
        Width="{Binding ViewModel.Width}" Height="{Binding ViewModel.Height}"
        AllowsTransparency="True"
        WindowStyle="None" ResizeMode="CanResizeWithGrip"
        Closing="Window_Closing"
        SizeChanged="Window_SizeChanged"
        LocationChanged="Window_LocationChanged"
        ContentRendered="Window_ContentRendered">
    <Window.Background>
        <SolidColorBrush Opacity="0.01" Color="Black"/>
    </Window.Background>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:OpacityToBackgroundBrushConverter x:Key="OpacityToBrushConverter"/>
        <!-- Hide ResizeGrip completely to prevent white border -->
        <Style TargetType="{x:Type ResizeGrip}">
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
        <!-- Remove Window chrome effects -->
        <Style TargetType="{x:Type Window}" BasedOn="{StaticResource WindowAll}">
            <Setter Property="WindowChrome.WindowChrome">
                <Setter.Value>
                    <WindowChrome
                        CaptionHeight="0"
                        ResizeBorderThickness="5"
                        GlassFrameThickness="0"
                        CornerRadius="0"
                        UseAeroCaptionButtons="False"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Behaviors:Interaction.Behaviors>
        <utils_ui:DragMoveBehavior IsEnabled="{Binding ViewModel.IsDraggable}" />
    </Behaviors:Interaction.Behaviors>
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="AUTO"/>
            <RowDefinition Height="1*" MinHeight="35"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Title bar - transparent RosyBrown background based on opacity slider -->
        <Grid Grid.Row="0"
              Background="{Binding ViewModel.ChatWindowOpacity, Converter={StaticResource OpacityToBrushConverter}, ConverterParameter=RosyBrown}"
              Height="20"/>
        <!-- Content area - transparent Black background based on opacity slider -->
        <Grid Grid.Row="1"
              Background="{Binding ViewModel.ChatWindowOpacity, Converter={StaticResource OpacityToBrushConverter}, ConverterParameter=Black}">
            <FlowDocumentScrollViewer Name="ChatPanel"
                Height="AUTO"
                Background="Transparent"
                Block.LineHeight="2" VerticalScrollBarVisibility="Visible"/>
        </Grid>
        <Border Grid.Row="2"
                Background="{Binding ViewModel.ChatWindowOpacity, Converter={StaticResource OpacityToBrushConverter}, ConverterParameter=Black}"
                MouseLeftButtonDown="ComposeArea_MouseLeftButtonDown" Padding="6">
            <Border.Resources>
                <!-- Keep the overlay readable and transparent in both app themes. -->
                <Style TargetType="{x:Type TextBlock}">
                    <Setter Property="Foreground" Value="White" />
                </Style>
                <Style TargetType="{x:Type TextBox}">
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="#808080" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CaretBrush" Value="White" />
                    <Setter Property="SelectionBrush" Value="#537CA6" />
                    <Setter Property="SelectionTextBrush" Value="White" />
                    <Setter Property="SelectionOpacity" Value="0.7" />
                    <Setter Property="Padding" Value="4,2" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type TextBox}">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        Padding="{TemplateBinding Padding}" CornerRadius="3">
                                    <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter Property="BorderBrush" Value="White" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Border.Resources>
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="230">
                <StackPanel>
                    <TextBox x:Name="ComposeInput" Text="{Binding Compose.InputText, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="{Binding Compose.IsBusy}" KeyDown="ComposeInput_KeyDown"
                             ToolTip="{i18n:StringLocalizer compose.hint}" AutomationProperties.Name="{i18n:StringLocalizer compose.input}"
                             TextWrapping="Wrap" AcceptsReturn="False" MinHeight="28" MaxHeight="70" VerticalScrollBarVisibility="Auto" />
                    <TextBlock Text="{Binding Compose.Status}" TextWrapping="Wrap" FontSize="11" AutomationProperties.LiveSetting="Polite">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Style.Triggers><DataTrigger Binding="{Binding Compose.Status}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel Visibility="{Binding Compose.Settings.ComposeShowDetails, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{i18n:StringLocalizer compose.result}" Margin="0,4,0,2" />
                        <TextBox Text="{Binding Compose.TranslatedText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="28" MaxHeight="60" VerticalScrollBarVisibility="Auto" />
                        <TextBlock Text="{i18n:StringLocalizer compose.back}" Margin="0,4,0,2" />
                        <TextBox Text="{Binding Compose.BackTranslation, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="28" MaxHeight="60" VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
