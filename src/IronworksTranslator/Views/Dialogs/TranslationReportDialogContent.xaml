<UserControl x:Class="IronworksTranslator.Views.Dialogs.TranslationReportDialogContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:i18n="http://schemas.lepo.co/i18n/2022/xaml"
             MinWidth="440"
             MaxWidth="560">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520" Focusable="False">
        <StackPanel Orientation="Vertical">
            <ui:TextBlock Text="{i18n:StringLocalizer chat.report.description}"
                          FontTypography="Caption"
                          TextWrapping="Wrap"
                          Opacity="0.85"/>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <ui:TextBlock Text="{i18n:StringLocalizer chat.report.engine}"
                              FontTypography="BodyStrong"
                              Margin="0,0,6,0"/>
                <ui:TextBlock Text="{Binding EngineDisplayLabel, Mode=OneWay}"
                              FontTypography="Body"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Margin="0,4,0,0"
                        Visibility="{Binding HasNpcSpeaker, Converter={StaticResource BoolToVisibility}}">
                <ui:TextBlock Text="{i18n:StringLocalizer chat.report.npc_speaker}"
                              FontTypography="BodyStrong"
                              Margin="0,0,6,0"/>
                <ui:TextBlock Text="{Binding OriginalNpcSpeaker, Mode=OneWay}"
                              FontTypography="Body"/>
            </StackPanel>

            <ui:TextBlock Text="{i18n:StringLocalizer chat.report.original}"
                          FontTypography="BodyStrong"
                          Margin="0,10,0,4"/>
            <ui:TextBox Text="{Binding SourceText, Mode=OneWay}"
                        IsReadOnly="True"
                        TextWrapping="Wrap"
                        MaxHeight="80"
                        VerticalScrollBarVisibility="Auto"/>

            <ui:TextBlock Text="{i18n:StringLocalizer chat.report.translated}"
                          FontTypography="BodyStrong"
                          Margin="0,8,0,4"/>
            <ui:TextBox Text="{Binding OriginalTranslation, Mode=OneWay}"
                        IsReadOnly="True"
                        TextWrapping="Wrap"
                        MaxHeight="80"
                        VerticalScrollBarVisibility="Auto"/>

            <Grid Margin="0,12,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ui:TextBlock Grid.Column="0"
                              Text="{i18n:StringLocalizer chat.report.suggested}"
                              FontTypography="BodyStrong"
                              VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button Content="{i18n:StringLocalizer chat.report.draft.reset}"
                               Command="{Binding ResetToCurrentDraftCommand}"
                               Appearance="Secondary"
                               Padding="8,4"
                               Margin="0,0,4,0"/>
                    <ui:Button Content="{i18n:StringLocalizer chat.report.draft.papago}"
                               Command="{Binding LoadPapagoDraftCommand}"
                               Appearance="Secondary"
                               Padding="8,4"
                               Margin="0,0,4,0"/>
                    <ui:Button Content="{i18n:StringLocalizer chat.report.draft.deepl}"
                               Command="{Binding LoadDeepLDraftCommand}"
                               ToolTip="{Binding DeepLDraftToolTip}"
                               ToolTipService.ShowOnDisabled="True"
                               Appearance="Secondary"
                               Padding="8,4"/>
                </StackPanel>
            </Grid>

            <ui:TextBlock Text="{Binding DraftStatusMessage}"
                          FontTypography="Caption"
                          Opacity="0.8"
                          Margin="0,0,0,4"
                          Visibility="{Binding HasDraftStatusMessage, Converter={StaticResource BoolToVisibility}}"/>

            <ui:TextBox x:Name="SuggestedTranslationTextBox"
                        Text="{Binding SuggestedTranslation, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap"
                        AcceptsReturn="True"
                        MinLines="2"
                        MaxLines="5"
                        MaxLength="1000"
                        VerticalScrollBarVisibility="Auto"/>

            <ui:TextBlock Text="{i18n:StringLocalizer chat.report.glossary}"
                          FontTypography="BodyStrong"
                          Margin="0,10,0,4"/>
            <ui:TextBox Text="{Binding GlossaryHintText, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap"
                        AcceptsReturn="True"
                        MinLines="1"
                        MaxLines="4"
                        MaxLength="500"
                        PlaceholderEnabled="True"
                        PlaceholderText="{i18n:StringLocalizer chat.report.glossary.placeholder}"
                        VerticalScrollBarVisibility="Auto"/>

            <Expander Header="{i18n:StringLocalizer chat.report.comment}"
                      IsExpanded="False"
                      Margin="0,10,0,0">
                <ui:TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap"
                            AcceptsReturn="True"
                            MinLines="2"
                            MaxLines="4"
                            MaxLength="500"
                            Margin="0,6,0,0"
                            PlaceholderEnabled="True"
                            PlaceholderText="{i18n:StringLocalizer chat.report.comment.placeholder}"
                            VerticalScrollBarVisibility="Auto"/>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
